def guilfred_send_temp(tag, temp):
    cmd = sprintf("bin/gfexec '(nd-new-temp! %s %.1f)'", tag, temp );
    printf("send_guilfred: %s\n", cmd);
    if(not args.norun):
        system(cmd)

